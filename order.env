POSTGRES_DB=order-service
POSTGRES_USER=order-service-user
POSTGRES_PASSWORD=order-service-password
POSTGRES_PORT=5432

DB_URI=postgres://order-service-user:order-service-password@localhost:5432/order-service?sslmode=disable
MIGRATIONS_DIR=migrations/order

# Версии Docker-образов
POSTGRES_IMAGE=postgres:18.3-alpine3.23

# Kafka
KAFKA_BROKERS=localhost:9092
ORDER_PAID_TOPIC=order.paid
SHIP_ASSEMBLED_TOPIC=assembly.ship-assembled
SHIP_ASSEMBLED_CONSUMER_GROUP_ID=order-service
